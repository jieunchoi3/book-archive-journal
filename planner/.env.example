# Shared Supabase project — planner tables live in the `planner` schema (not public).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Single-user silent auth (create this user once in Supabase Dashboard → Authentication → Users)
VITE_APP_EMAIL=your-email@example.com
VITE_APP_PASSWORD=your-password

# Run supabase/schema.sql in the Supabase SQL editor before first use.
# Add "planner" to Dashboard → Settings → API → Exposed schemas.
